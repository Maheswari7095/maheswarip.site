# SEO Meta Extractor Tool
# Save this file as: seo_meta_extractor.py
# Run using: python seo_meta_extractor.py

import requests
from bs4 import BeautifulSoup
import pandas as pd
from urllib.parse import urlparse
import time

# -----------------------------
# INPUT URLS
# -----------------------------
urls = [
    "https://example.com",
    "https://www.wikipedia.org",
    "https://www.python.org"
]

# -----------------------------
# FUNCTION TO EXTRACT META DATA
# -----------------------------
def extract_meta(url):
    data = {
        "URL": url,
        "Status Code": "",
        "Title": "",
        "Meta Description": "",
        "Meta Keywords": "",
        "Canonical": "",
        "Robots": "",
        "H1": "",
        "H2 Count": "",
        "Open Graph Title": "",
        "Open Graph Description": "",
        "Twitter Title": "",
        "Twitter Description": "",
        "Favicon": "",
        "Language": "",
        "Word Count": "",
        "Error": ""
    }

    try:
        headers = {
            "User-Agent": "Mozilla/5.0"
        }

        response = requests.get(url, headers=headers, timeout=15)
        data["Status Code"] = response.status_code

        soup = BeautifulSoup(response.text, "html.parser")

        # Title
        if soup.title:
            data["Title"] = soup.title.text.strip()

        # Meta Description
        desc = soup.find("meta", attrs={"name": "description"})
        if desc and desc.get("content"):
            data["Meta Description"] = desc["content"].strip()

        # Meta Keywords
        keywords = soup.find("meta", attrs={"name": "keywords"})
        if keywords and keywords.get("content"):
            data["Meta Keywords"] = keywords["content"].strip()

        # Canonical
        canonical = soup.find("link", attrs={"rel": "canonical"})
        if canonical and canonical.get("href"):
            data["Canonical"] = canonical["href"]

        # Robots
        robots = soup.find("meta", attrs={"name": "robots"})
        if robots and robots.get("content"):
            data["Robots"] = robots["content"]

        # H1
        h1 = soup.find("h1")
        if h1:
            data["H1"] = h1.get_text(strip=True)

        # H2 Count
        h2_tags = soup.find_all("h2")
        data["H2 Count"] = len(h2_tags)

        # Open Graph
        og_title = soup.find("meta", property="og:title")
        if og_title and og_title.get("content"):
            data["Open Graph Title"] = og_title["content"]

        og_desc = soup.find("meta", property="og:description")
        if og_desc and og_desc.get("content"):
            data["Open Graph Description"] = og_desc["content"]

        # Twitter Meta
        twitter_title = soup.find("meta", attrs={"name": "twitter:title"})
        if twitter_title and twitter_title.get("content"):
            data["Twitter Title"] = twitter_title["content"]

        twitter_desc = soup.find("meta", attrs={"name": "twitter:description"})
        if twitter_desc and twitter_desc.get("content"):
            data["Twitter Description"] = twitter_desc["content"]

        # Favicon
        favicon = soup.find("link", rel=lambda x: x and "icon" in x.lower())
        if favicon and favicon.get("href"):
            data["Favicon"] = favicon["href"]

        # Language
        html_tag = soup.find("html")
        if html_tag and html_tag.get("lang"):
            data["Language"] = html_tag["lang"]

        # Word Count
        body_text = soup.get_text(separator=" ", strip=True)
        data["Word Count"] = len(body_text.split())

    except Exception as e:
        data["Error"] = str(e)

    return data


# -----------------------------
# PROCESS URLS
# -----------------------------
results = []

for url in urls:
    print(f"Extracting: {url}")
    result = extract_meta(url)
    results.append(result)
    time.sleep(1)

# -----------------------------
# SAVE TO EXCEL
# -----------------------------
df = pd.DataFrame(results)

output_file = "seo_meta_output.xlsx"
df.to_excel(output_file, index=False)

print("\nSEO Meta Extraction Completed!")
print(f"Output saved as: {output_file}")
